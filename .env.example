# Port/host for the API server
COMPILERX_HOST=127.0.0.1
COMPILERX_PORT=8000
# SQLite file for diagnostic history + benchmark runs
COMPILERX_DB=data/compilerx.db
# Trained model location
COMPILERX_MODEL=data/model/ranker.joblib
# Program execution is OFF by default. It is NOT a security sandbox (rlimits+timeout+netns only, no filesystem/PID
# isolation). Enable ONLY inside a disposable container/VM.
COMPILERX_ENABLE_EXECUTION=0
